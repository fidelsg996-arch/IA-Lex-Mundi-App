import { useState, useEffect } from 'react';
import { getPartidasByRonda } from '../services/torneoStorage';

export function usePartidaActiva(torneoId, usuarioEmail, rondaActual) {
  const [partidaActiva, setPartidaActiva] = useState(null);

  useEffect(() => {
    if (!torneoId || !usuarioEmail || !rondaActual) return;
    const partidas = getPartidasByRonda(torneoId, rondaActual);
    const miPartida = partidas.find(p => p.jugador1_email === usuarioEmail || p.jugador2_email === usuarioEmail);
    if (miPartida && miPartida.estado === 'en_juego') {
      setPartidaActiva(miPartida);
    } else {
      setPartidaActiva(null);
    }
  }, [torneoId, usuarioEmail, rondaActual]);

  return { partidaActiva };
}